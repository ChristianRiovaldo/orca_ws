<sdf version='1.10'>
  <world name='empty'>
    <physics name='1ms' type='ignored'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system'/>
    
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin filename="libgz-sim-imu-system.so"
            name="gz::sim::systems::Imu">
    </plugin>

    <gravity>0 0 -9.8000000000000007</gravity>
    <plugin
        filename="gz-sim-buoyancy-system"
        name="gz::sim::systems::Buoyancy">
        <graded_buoyancy>
          <default_density>1000</default_density>
          <density_change>
            <above_depth>0</above_depth>
            <density>1</density>
          </density_change>
        </graded_buoyancy>
        <enable>ORCA_V3</enable>
    </plugin>

    <magnetic_field>5.5644999999999998e-06 2.2875799999999999e-05 -4.2388400000000002e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <scene>
      <ambient>0.400000006 0.400000006 0.400000006 1</ambient>
      <background>0.699999988 0.699999988 0.699999988 1</background>
      <shadows>true</shadows>
    </scene>
    
    <light name='sun' type='directional'>
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.5 0.10000000000000001 -0.90000000000000002</direction>
      <diffuse>0.800000012 0.800000012 0.800000012 1</diffuse>
      <specular>0.200000003 0.200000003 0.200000003 1</specular>
      <attenuation>
        <range>1000</range>
        <linear>0.01</linear>
        <constant>0.90000000000000002</constant>
        <quadratic>0.001</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>

    <model name="gate">
      <pose>10 0 -1.56 0 0 1.5708</pose>
      <static>true</static>

      <link name="link">

        <!-- TIANG KIRI (ORANGE) -->
        <visual name="left_post">
          <pose>-0.75 0 0.8 0 0 0</pose>
          <geometry>
            <box><size>0.04 0.04 1.6</size></box>
          </geometry>
          <material>
            <ambient>1.0 0.35 0.0 1.0</ambient>
            <diffuse>1.0 0.4 0.0 1.0</diffuse>
          </material>
        </visual>

        <!-- TIANG KANAN (ORANGE) -->
        <visual name="right_post">
          <pose>0.75 0 0.8 0 0 0</pose>
          <geometry>
            <box><size>0.04 0.04 1.6</size></box>
          </geometry>
          <material>
            <ambient>1.0 0.35 0.0 1.0</ambient>
            <diffuse>1.0 0.4 0.0 1.0</diffuse>
          </material>
        </visual>

        <!-- PALANG ATAS (HITAM) -->
        <visual name="top_bar">
          <pose>0 0 1.6 0 0 0</pose>
          <geometry>
            <box><size>1.5 0.04 0.04</size></box>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1.0</ambient>
            <diffuse>0.1 0.1 0.1 1.0</diffuse>
          </material>
        </visual>

      </link>
    </model>
  
  </world>
</sdf>
