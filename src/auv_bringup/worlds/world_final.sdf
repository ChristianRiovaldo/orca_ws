    <!-- ===================== OBSTACLE ===================== -->
    <model name="obstacle">
      <pose>6 0.1 -1.4 0 0 0</pose>
      <static>true</static>
      <link name="link">

        <visual name="obstacle_visual">
          <pose>0 0 0.75 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.075</radius>
              <length>1.5</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>1.0 0.35 0.0 1.0</ambient>
            <diffuse>1.0 0.4 0.0 1.0</diffuse>
          </material>
        </visual>

        <collision name="obstacle_collision">
          <pose>0 0 0.75 0 0 0</pose>
          <geometry>
            <box><size>0.15 0.15 1.5</size></box>
          </geometry>
        </collision>

      </link>
    </model>

    <!-- ================= RED FLARE ================= -->
    <!-- Merah flare dibuat sangat terang -->
    <model name="red_flare">
      <pose>11.5 2.5 -1.5 0 0 0</pose>
      <static>true</static>
      <link name="link">

        <visual name="base_visual">
          <pose>0 0 0.01 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.016</radius><length>0.02</length></cylinder>
          </geometry>
          <material>
            <ambient>1.0 0.15 0.15 1.0</ambient>
            <diffuse>1.0 0.05 0.05 1.0</diffuse>
            <specular>0.8 0.2 0.2 1.0</specular>
          </material>
        </visual>

        <visual name="flare_visual">
          <pose>0 0 0.40 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.01</radius><length>0.80</length></cylinder>
          </geometry>
          <material>
            <ambient>1.0 0.1 0.1 1.0</ambient>
            <diffuse>1.0 0.0 0.0 1.0</diffuse>
            <specular>1.0 0.4 0.4 1.0</specular>
            <emissive>0.6 0.0 0.0 1.0</emissive>
          </material>
        </visual>

        <visual name="ball_visual">
          <pose>0 0 0.808 0 0 0</pose>
          <geometry>
            <sphere><radius>0.01</radius></sphere>
          </geometry>
          <material>
            <ambient>1.0 1.0 1.0 1.0</ambient>
            <diffuse>1.0 1.0 1.0 1.0</diffuse>
            <specular>0.9 0.9 0.9 1.0</specular>
          </material>
        </visual>

      </link>
    </model>

