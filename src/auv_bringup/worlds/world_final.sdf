<sdf version='1.10'>
  <world name='empty'>

    <!-- ================= PHYSICS ================= -->
    <physics name='1ms' type='ignored'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- ================= CORE PLUGINS ================= -->
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system'/>

    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin filename="libgz-sim-imu-system.so"
            name="gz::sim::systems::Imu"/>

    <plugin filename="gz-sim-buoyancy-system"
            name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>1000</default_density>
        <density_change>
          <above_depth>0</above_depth>
          <density>1</density>
        </density_change>
      </graded_buoyancy>
      <enable>ORCA_V3</enable>
    </plugin>

    <!-- ================= ENVIRONMENT ================= -->
    <gravity>0 0 -9.8</gravity>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <light name='sun' type='directional'>
      <pose>0 0 20 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ================= KOLAM ================= -->
    <model name="pool">
      <static>true</static>
      <link name="pool_link">

        <collision name="floor">
          <pose>11.5 0 -1.6 0 0 0</pose>
          <geometry><box><size>25 16 0.2</size></box></geometry>
        </collision>

        <visual name="floor">
          <pose>11.5 0 -1.6 0 0 0</pose>
          <geometry><box><size>25 16 0.2</size></box></geometry>
          <material>
            <ambient>0.4 0.75 1.0 1.0</ambient>
            <diffuse>0.45 0.80 1.0 1.0</diffuse>
            <specular>0.2 0.5 0.8 1.0</specular>
          </material>
        </visual>

        <collision name="wall_x1">
          <pose>11.5 8 -0.8 0 0 0</pose>
          <geometry><box><size>25 0.2 1.6</size></box></geometry>
        </collision>

        <collision name="wall_x2">
          <pose>11.5 -8 -0.8 0 0 0</pose>
          <geometry><box><size>25 0.2 1.6</size></box></geometry>
        </collision>

        <collision name="wall_y1">
          <pose>24 0 -0.8 0 0 0</pose>
          <geometry><box><size>0.2 16 1.6</size></box></geometry>
        </collision>

        <collision name="wall_y2">
          <pose>-1 0 -0.8 0 0 0</pose>
          <geometry><box><size>0.2 16 1.6</size></box></geometry>
        </collision>

      </link>
    </model>

    <!-- ================= GATE FINAL ================= -->
    <!-- Merah gate dibuat lebih gelap -->
    <model name="gate">
      <pose>16 -1 -1.6 0 0 1.5708</pose>
      <static>true</static>
      <link name="link">

        <!-- Kiri -->
        <visual name="left_black_1">
          <pose>-0.75 0 0.05 0 0 0</pose>
          <geometry><box><size>0.04 0.04 0.10</size></box></geometry>
          <material>
            <ambient>0.05 0.05 0.05 1.0</ambient>
            <diffuse>0.1 0.1 0.1 1.0</diffuse>
