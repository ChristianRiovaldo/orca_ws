        <collision name="left_black_3">
          <pose>-0.75 0 0.80 0 0 0</pose>
          <geometry><box><size>0.04 0.04 0.20</size></box></geometry>
        </collision>

        <collision name="right_green_3">
          <pose>-0.75 0 0.97 0 0 0</pose>
          <geometry><box><size>0.04 0.04 0.14</size></box></geometry>
        </collision>

        <!-- Kanan -->
        <collision name="right_black_1">
          <pose>0.75 0 0.05 0 0 0</pose>
          <geometry><box><size>0.04 0.04 0.10</size></box></geometry>
        </collision>

        <!-- MERAH GATE -->
        <collision name="left_red_1">
          <pose>0.75 0 0.20 0 0 0</pose>
