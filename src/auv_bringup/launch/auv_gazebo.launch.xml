<launch>
    <let name="urdf_path"
         value="$(find-pkg-share auv_description)/urdf/auv.urdf.xacro"/>
    <let name="gazebo_config_path"
         value="$(find-pkg-share auv_bringup)/config/gazebo_bridge.yaml"/>
    <let name="rviz_config_path"
         value="$(find-pkg-share auv_description)/rviz/urdf_config.rviz"/>

    <node pkg="robot_state_publisher" exec="robot_state_publisher">
        <param name="robot_description"
               value="$(command 'xacro $(var urdf_path)')"/>
    </node>

    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
        <arg name="gz_args" value="$(find-pkg-share auv_bringup)/worlds/world_final.sdf"/>
    </include>

    <node pkg="ros_gz_sim" exec="create" args="-topic robot_description"/>

    <node pkg="ros_gz_bridge" exec="parameter_bridge"
          args="/model/ORCA_V3/pose@geometry_msgs/msg/Pose[gz.msgs.Pose" />

    <node pkg="ros_gz_bridge" exec="parameter_bridge"
          args="/world/empty/model/ORCA_V3/link/base_footprint/sensor/imu_sensor/imu@sensor_msgs/msg/Imu[gz.msgs.IMU" />

    <node pkg="rviz2" exec="rviz2" output="screen"
          args="-d $(var rviz_config_path)"/>

     <node pkg="ros_gz_bridge" exec="parameter_bridge"
          args="/camera/image_raw@sensor_msgs/msg/Image@gz.msgs.Image" />

     <node pkg="ros_gz_bridge" exec="parameter_bridge"
          args="/camera/camera_info@sensor_msgs/msg/CameraInfo@gz.msgs.CameraInfo" />
</launch>