<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="cyl_radius" value="0.02"/>
    <xacro:property name="cyl_length" value="0.01"/>

    <xacro:property name="camera_length" value="0.06" />
    <xacro:property name="camera_width" value="0.04" />
    <xacro:property name="camera_height" value="0.01" />

    <material name="grey">
        <color rgba="0.5 0.5 0.5 1" />
    </material>

    <link name="camera_link">
        <visual>
            <geometry>
                <cylinder radius="${cyl_radius}" length="${cyl_length}"/>
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <material name="grey"/>
        </visual>        
        <collision>
            <geometry>
                <cylinder radius="${cyl_radius}" length="${cyl_length}"/>
            </geometry>
        </collision>
    </link>

    <joint name="camera_joint" type="fixed">
        <origin xyz="0.23 0.0 0.03" rpy="0.0 0.0 0.0"/>
        <parent link="base_footprint"/>
        <child link="camera_link"/>
    </joint>

    <link name="camera_link_optical" />

    <joint name="camera_optical_joint" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="camera_link"/>
        <child link="camera_link_optical"/>
    </joint>

    <link name="imu_link">
        <visual>
            <geometry>
                <box size="${camera_length} ${camera_width} ${camera_height}" />
            </geometry>
            <material name="grey" />
        </visual>
        <collision>
            <geometry>
                <box size="${camera_length} ${camera_width} ${camera_height}" />
            </geometry>
        </collision>
    </link>

    <joint name="imu_joint" type="fixed">
        <origin xyz="0.0 0.0 0.0" rpy="3.142 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="imu_link"/>
    </joint>

</robot>