<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    
    <xacro:macro name="body_inertia">
        <inertial>
            <origin xyz="0.0 0.0 -0.211" rpy="0.0 0.0 0.0"/>
            <mass value="10"/>
            <inertia ixx="0.11" ixy="0.0" ixz="0.0" 
                     iyy="0.26" iyz="0.0" 
                     izz="0.21"/>
        </inertial>
    </xacro:macro>

    <xacro:macro name="thruster_inertia">
        <inertial>
            <mass value="0.002"/>
            <inertia ixx="0.001" ixy="0.0" ixz="0.0" 
                     iyy="0.001" iyz="0.0" 
                     izz="0.001"/>
        </inertial>
    </xacro:macro>

</robot>